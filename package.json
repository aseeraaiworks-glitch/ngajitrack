{
  "name": "ngajitrack-backend-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter @ngajitrack/web dev",
    "dev:web:local": "node scripts/web-local.mjs dev",
    "build:web": "pnpm --filter @ngajitrack/web build",
    "lint:web": "pnpm --filter @ngajitrack/web lint",
    "typecheck:web": "pnpm --filter @ngajitrack/web typecheck",
    "test:web:unit": "pnpm --filter @ngajitrack/web test:unit",
    "test:web": "node scripts/test-web.mjs",
    "test": "node --test --test-concurrency=1 tests/foundation.test.mjs tests/enrollments.test.mjs",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:api": "node scripts/test-api.mjs",
    "test:isolated": "node scripts/test-isolated.mjs",
    "test:concurrency": "node --test --test-concurrency=1 tests/concurrency.test.mjs",
    "test:scheduler": "node scripts/test-scheduler.mjs",
    "test:upgrade": "node scripts/test-approval-upgrade.mjs",
    "test:workflow-api": "node scripts/test-workflow-api.mjs",
    "test:workflow-sql": "node scripts/test-workflow-regression.mjs",
    "verify:workflow-local": "node scripts/verify-workflow-local.mjs",
    "test:governance": "node scripts/test-governance.mjs",
    "test:governance-concurrency": "node scripts/test-governance-regression.mjs concurrency",
    "test:governance-scheduler": "node scripts/test-governance-regression.mjs scheduler",
    "verify:governance-local": "node scripts/verify-governance-local.mjs"
  },
  "packageManager": "pnpm@11.19.0",
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "pg": "8.23.0",
    "supabase": "2.117.0"
  }
}
